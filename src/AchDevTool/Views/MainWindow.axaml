<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:AchDevTool.Views"
        xmlns:vm="using:AchDevTool.ViewModels"
        x:Class="AchDevTool.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AchDev Tool"
        Width="960" Height="700"
        MinWidth="800" MinHeight="600"
        Icon="/Assets/app.ico">

  <Grid ColumnDefinitions="180,*">

    <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Tools"
                   Margin="20,20,16,10"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextMutedBrush}" />

        <StackPanel DockPanel.Dock="Top">
          <Button Classes="nav-btn"
                  Classes.active="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Build}"
                  Command="{Binding SelectCategoryCommand}" CommandParameter="Build">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🔨" FontSize="15" />
              <TextBlock Text="Build" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav-btn"
                  Classes.active="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Ai}"
                  Command="{Binding SelectCategoryCommand}" CommandParameter="Ai">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🤖" FontSize="15" />
              <TextBlock Text="AI" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="nav-btn"
                  Classes.active="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Git}"
                  Command="{Binding SelectCategoryCommand}" CommandParameter="Git">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="⌘" FontSize="15" />
              <TextBlock Text="Git" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── Content ─────────────────────────────────────────────────────── -->
    <Grid Grid.Column="1" Margin="28,24">
      <ContentControl Content="{Binding Build}"
                       IsVisible="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Build}">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <views:BuildView />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <ContentControl Content="{Binding Ai}"
                       IsVisible="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Ai}">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <views:AiView />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <ContentControl Content="{Binding Git}"
                       IsVisible="{Binding SelectedCategory, Converter={StaticResource EnumEquals}, ConverterParameter=Git}">
        <ContentControl.ContentTemplate>
          <DataTemplate>
            <views:GitView />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
    </Grid>

  </Grid>
</Window>
