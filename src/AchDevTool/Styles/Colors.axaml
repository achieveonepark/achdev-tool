<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="AppBgColor">#F6F6F6</Color>
  <Color x:Key="SidebarBgColor">#ECECEC</Color>
  <Color x:Key="CardBgColor">#FAFAFA</Color>
  <Color x:Key="SurfaceBgColor">#FFFFFF</Color>
  <Color x:Key="BorderColor">#E0E0E0</Color>
  <Color x:Key="BorderStrongColor">#CCCCCC</Color>

  <Color x:Key="TextPrimaryColor">#0F0F0F</Color>
  <Color x:Key="TextSecondaryColor">#666666</Color>
  <Color x:Key="TextMutedColor">#999999</Color>

  <Color x:Key="AccentColor">#007AFF</Color>
  <Color x:Key="AccentHoverColor">#0066D6</Color>

  <Color x:Key="SuccessTextColor">#2E7D32</Color>
  <Color x:Key="SuccessBgColor">#E8F5E9</Color>
  <Color x:Key="ErrorTextColor">#C62828</Color>
  <Color x:Key="ErrorBgColor">#FDECEA</Color>
  <Color x:Key="WarningTextColor">#B26A00</Color>
  <Color x:Key="WarningBgColor">#FFF3E0</Color>

  <Color x:Key="ButtonSecondaryBgColor">#EEF0F2</Color>
  <Color x:Key="ButtonSecondaryHoverBgColor">#E2E5E8</Color>

  <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
  <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
  <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />
  <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}" />
  <SolidColorBrush x:Key="BorderBrush2" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />

  <SolidColorBrush x:Key="SuccessTextBrush" Color="{StaticResource SuccessTextColor}" />
  <SolidColorBrush x:Key="SuccessBgBrush" Color="{StaticResource SuccessBgColor}" />
  <SolidColorBrush x:Key="ErrorTextBrush" Color="{StaticResource ErrorTextColor}" />
  <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource ErrorBgColor}" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}" />
  <SolidColorBrush x:Key="WarningBgBrush" Color="{StaticResource WarningBgColor}" />

  <SolidColorBrush x:Key="ButtonSecondaryBgBrush" Color="{StaticResource ButtonSecondaryBgColor}" />
  <SolidColorBrush x:Key="ButtonSecondaryHoverBgBrush" Color="{StaticResource ButtonSecondaryHoverBgColor}" />

</ResourceDictionary>
